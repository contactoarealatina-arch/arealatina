SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=arealatina_db
DB_USER=postgres
DB_PASSWORD=tu-password
DB_HOST=localhost
DB_PORT=5432

# Backend de correo. Sin esta variable, en desarrollo (DEBUG=True) los
# correos solo se imprimen en la terminal y parece que "no llegan".
#   brevo   = envio real por la API HTTPS de Brevo (recomendado en Railway)
#   smtp    = envio real por SMTP (solo Railway Pro o un hosting que lo permita)
#   consola = solo se imprimen, no salen de la maquina
EMAIL_BACKEND=brevo
BREVO_API_KEY=la-clave-api-de-brevo
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=b31a8d001@smtp-brevo.com
EMAIL_HOST_PASSWORD=la-clave-smtp-de-brevo
DEFAULT_FROM_EMAIL=Area Latina Estudio <contacto@arealatinaestudio.cl>
# Correo donde llegan los mensajes del formulario y las alertas
CONTACTO_EMAIL=contacto.arealatina@gmail.com
# Dominio del sitio, para los enlaces dentro de los correos
SITIO_URL=http://localhost:8000
# Numero de WhatsApp de la academia, solo digitos: 56912345678
WHATSAPP_NUMERO=

# Cifrado de campos sensibles. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: si se pierde esta clave, los datos cifrados no se recuperan.
FIELD_ENCRYPTION_KEY=genera-la-tuya-con-fernet

# Direccion publica del sitio (para los enlaces de los correos)

# Modo SSL de PostgreSQL: 'require' en produccion, 'prefer' en local
DB_SSLMODE=prefer

# Cloudflare R2 para las fotos (dejar vacio usa el disco local)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Resenas de Google. Sacar el enlace corto desde business.google.com,
# en "Pedir resenas". Tiene la forma https://g.page/r/CODIGO/review
# Mientras este vacio, los botones de resena no se muestran.
GOOGLE_REVIEW_LINK=https://g.page/r/TU-CODIGO/review
# Se actualiza a mano cada cierto tiempo
GOOGLE_RATING=5,0
GOOGLE_TOTAL_RESENAS=0

# ---------------------------------------------------------------------
# Solo en el servidor (Railway)
# ---------------------------------------------------------------------
# Railway entrega la base como una sola URL. Se conecta con "Variable
# reference" al servicio Postgres, no se copia a mano.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Mientras este en true, el sitio solo se le muestra a quien tenga
# cuenta. Es el interruptor para tenerlo arriba sin que lo vea la gente:
# se cambia en Railway, sin tocar codigo.
SITIO_PRIVADO=false
# Sin valor de ejemplo: genera uno nuevo y guárdalo solo como secreto del hosting.
SITIO_PIN=

# Dominios que puede responder el servidor, separados por coma.
# ALLOWED_HOSTS=arealatinaestudio.cl,www.arealatinaestudio.cl
# CSRF_TRUSTED_ORIGINS=https://arealatinaestudio.cl,https://www.arealatinaestudio.cl

# Dominio de los correos con que entran las profesoras
DOMINIO_PROFESORAS=arealatina.cl

# ---------------------------------------------------------------------
# Google Analytics
# ---------------------------------------------------------------------
# Solo mide el sitio publico, y solo si el visitante acepta en el aviso
# de cookies. Vaciar la variable apaga la medicion por completo.
GA_MEASUREMENT_ID=G-LXN4MY2SB5
# En la maquina de desarrollo no se mide, para no ensuciar los numeros
# reales con las pruebas. En true tambien mide en local.
GA_EN_DESARROLLO=False

# ---------------------------------------------------------------------
# Avisos de errores del servidor
# ---------------------------------------------------------------------
# Con DEBUG=False, Django manda un correo cada vez que una vista
# revienta con un 500. Formato: Nombre:correo, separados por coma.
ADMINS=Equipo:contacto.arealatina@gmail.com
SERVER_EMAIL=sistema@arealatinaestudio.cl
