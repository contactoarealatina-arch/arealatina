SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=arealatina_db
DB_USER=postgres
DB_PASSWORD=tu-password
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=b31a8d001@smtp-brevo.com
EMAIL_HOST_PASSWORD=la-clave-smtp-de-brevo
DEFAULT_FROM_EMAIL=Area Latina Estudio <contacto.arealatina@gmail.com>
# Correo donde llegan los mensajes del formulario y las alertas
CONTACTO_EMAIL=contacto.arealatina@gmail.com
# Dominio del sitio, para los enlaces dentro de los correos
SITIO_URL=http://localhost:8000
# Numero de WhatsApp de la academia, solo digitos: 56912345678
WHATSAPP_NUMERO=

# Cifrado de campos sensibles. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OJO: si se pierde esta clave, los datos cifrados no se recuperan.
FIELD_ENCRYPTION_KEY=genera-la-tuya-con-fernet

# Direccion publica del sitio (para los enlaces de los correos)

# Modo SSL de PostgreSQL: 'require' en produccion, 'prefer' en local
DB_SSLMODE=prefer

# Cloudflare R2 para las fotos (dejar vacio usa el disco local)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Resenas de Google. Sacar el enlace corto desde business.google.com,
# en "Pedir resenas". Tiene la forma https://g.page/r/CODIGO/review
# Mientras este vacio, los botones de resena no se muestran.
GOOGLE_REVIEW_LINK=https://g.page/r/TU-CODIGO/review
# Se actualiza a mano cada cierto tiempo
GOOGLE_RATING=5,0
GOOGLE_TOTAL_RESENAS=0
